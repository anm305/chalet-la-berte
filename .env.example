# Web3Forms: https://web3forms.com — endpoint + access key
# Formspree: set PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxx and leave ACCESS_KEY empty
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_ACCESS_KEY=

# Used only in the form error message (never written into HTML)
PUBLIC_CONTACT_EMAIL=

# WhatsApp / téléphone affiché dans la section contact (chiffres uniquement, ex. 41791234567)
PUBLIC_CONTACT_PHONE=41774597935

# Remise directe vs tarif Airbnb / PriceLabs (ex. 10 = −10 %)
PUBLIC_DIRECT_DISCOUNT_PERCENT=10

# Fallback plat si PriceLabs n’est pas encore branché (CHF / nuit Airbnb de référence)
PUBLIC_AIRBNB_NIGHTLY_CHF=

# --- Indexation prix Airbnb (recommandé) ---
# 1. Créer un compte PriceLabs et connecter l’annonce Airbnb
# 2. Activer Customer API → coller la clé ici
# 3. listing_id = ID PriceLabs de l’annonce (pas forcément l’ID Airbnb)
PRICELABS_API_KEY=
PRICELABS_LISTING_ID=
PRICELABS_PMS=airbnb

# Flux iCal publics, séparés par des virgules (Airbnb, Booking, Google Agenda)
# Airbnb hôte → Calendrier → Exporter le calendrier → coller l’URL .ics ici
# Si vide, le calendrier est remplacé par un sélecteur de dates dans le formulaire
ICAL_FEED_URLS=
