# Web3Forms: https://web3forms.com — endpoint + access key
# Formspree: set PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxx and leave ACCESS_KEY empty
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_ACCESS_KEY=

# Used only in the form error message (never written into HTML)
PUBLIC_CONTACT_EMAIL=

# WhatsApp / téléphone affiché dans la section contact (chiffres uniquement, ex. 41791234567)
PUBLIC_CONTACT_PHONE=41774597935

# Remise directe vs tarif Airbnb (ex. 10 = −10 %)
PUBLIC_DIRECT_DISCOUNT_PERCENT=10

# Fallback plat si ni CSV ni PriceLabs (CHF / nuit)
PUBLIC_AIRBNB_NIGHTLY_CHF=

# --- Prix Airbnb (gratuit) ---
# Exporter le calendrier hôte via l’extension « Airbnb Host Rate Exporter »
# puis : npm run import:rates -- ~/Downloads/export.csv
# → écrit data/rates.csv (lu par /api/quote)

# --- Prix Airbnb (auto, payant) ---
PRICELABS_API_KEY=
PRICELABS_LISTING_ID=
PRICELABS_PMS=airbnb

# Flux iCal publics (disponibilités seulement, pas les prix)
ICAL_FEED_URLS=
